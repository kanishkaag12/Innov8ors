# ====== API Configuration ======
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_EMBEDDING_SERVICE_URL=http://127.0.0.1:8001

# ====== Payment Gateway (Optional) ======
# Get your public key from Razorpay: https://dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_public_key_here

# ====== Analytics (Optional) ======
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=your_ga_measurement_id_here

# ====== Feature Flags ======
NEXT_PUBLIC_ENABLE_ML_RANKING=true
