# =============================================================================
# SynapEscrow – Root .env.example
# =============================================================================
# Copy this file to .env and fill in your real secrets.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# ── Host port bindings (change these if ports conflict locally) ───────────────
FRONTEND_PORT=3000
BACKEND_PORT=5000

# =============================================================================
# FRONTEND
# =============================================================================
# The URL the browser uses to reach the backend API.
# In production: your backend's public domain (e.g. https://api.synapescrow.com)
# In local Docker: http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# =============================================================================
# BACKEND
# =============================================================================

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Use the direct connection string (no SRV) to avoid DNS resolution issues.
# Format: mongodb://user:password@host1:27017,host2:27017,host3:27017/db?ssl=true&replicaSet=...
MONGO_URI=mongodb://YOUR_DB_USER:YOUR_DB_PASSWORD@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/synapescrow?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=${MONGO_URI}

# ── Neon PostgreSQL (Prisma / backend) ───────────────────────────────────────
# Used by Prisma (Job, SavedJob, JobInteraction, User tables).
DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-xxxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be a strong, random secret (≥32 characters).
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars

# ── AI / LLM Keys ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME
GROQ_API_KEY=gsk_REPLACE_ME
GEMINI_API_KEY=AIzaSy_REPLACE_ME

# SynapBot Gemma 4 (optional)
GEMMA4_API_KEY=
GEMMA4_API_BASE_URL=
GEMMA4_MODEL=gemma-4

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# ── GitHub (for profile/portfolio enrichment) ────────────────────────────────
GITHUB_TOKEN=ghp_REPLACE_ME

# =============================================================================
# ML RANKING SYSTEM
# =============================================================================
# Separate DATABASE_URL for the ML service (can point to the same Neon project
# or a different Postgres instance).
ML_DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-xxxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Only used if ML_DATABASE_URL is NOT set:
ML_DB_HOST=localhost
ML_DB_PORT=5432
ML_DB_NAME=synapescrow_ml
ML_DB_USER=postgres
ML_DB_PASSWORD=REPLACE_ME
